{
  "name": "ksitepulse",
  "version": "1.1.0",
  "description": "Chrome extension that monitors page health in real time — Everyday Mode for plain-language summaries and Developer Mode for full metrics, waterfall, and console streaming.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "chrome-extension",
    "web-vitals",
    "performance",
    "devtools",
    "page-health",
    "crx",
    "preact"
  ],
  "author": {
    "name": "Kibuthi"
  },
  "license": "MIT",
  "homepage": "https://github.com/kibmuikia/ksitepulse/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/kibmuikia/ksitepulse"
  },
  "bugs": {
    "url": "https://github.com/kibmuikia/ksitepulse/issues"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite build --watch",
    "prebuild": "biome check src",
    "build": "vite build",
    "tsc": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/create-icons.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@crxjs/vite-plugin": "^2.5.0",
    "@preact/preset-vite": "^2.10.5",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.2",
    "only-allow": "^1.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "preact": "^10.29.2",
    "web-vitals": "^5.3.0"
  }
}
